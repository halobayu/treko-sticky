{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://gambirstudio.com; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "alwaysOnTop": false,
        "decorations": false,
        "height": 680,
        "minHeight": 360,
        "minWidth": 280,
        "resizable": true,
        "skipTaskbar": false,
        "transparent": true,
        "title": "Treko Sticky",
        "visible": true,
        "width": 380,
        "label": "main"
      }
    ],
    "withGlobalTauri": true
  },
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "targets": [
      "msi",
      "nsis"
    ]
  },
  "identifier": "com.gambirstudio.treko-sticky",
  "productName": "Treko Sticky",
  "version": "0.1.0"
}
